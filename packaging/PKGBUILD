# Maintainer: Mahesh Diwan <mahesh.diwan@example.com>
# Contributor: flexfetch maintainers
#
# flexfetch — AUR package
# Builds the release config (--no-default-features + live,image-logos,completions),
# matching the GitHub release binaries. To bump for a new release, update pkgver,
# regenerate sha256sums (updpkgsums), and keep `source`'s tag in sync.
#
# Note: unlike the original plan there are no assets/themes or assets/logos dirs —
# themes and logos are embedded in the binary (see ROADMAP 1.2/1.3), so only the
# binary, man page, and completions are installed.

pkgname=flexfetch
pkgver=0.18.0
pkgrel=1
pkgdesc="Blazing-fast system information tool"
arch=('x86_64' 'aarch64')
url="https://github.com/mahesh-diwan/flexfetch"
license=('MIT')
depends=('glibc')
makedepends=('rust' 'cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/mahesh-diwan/flexfetch/archive/v$pkgver.tar.gz")
sha256sums=('3fb3df32a880dee79698bf79d4c58da40b95bd5984eaa098b462cfef7650a24b')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked \
    --no-default-features --features live,image-logos,completions
}

# No check(): the workspace suite needs live /proc + /sys (and some collectors
# hit the network), which is flaky inside AUR build chroots. CI runs the tests.

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/flexfetch "$pkgdir/usr/bin/flexfetch"
  install -Dm644 doc/flexfetch.1 "$pkgdir/usr/share/man/man1/flexfetch.1"
  install -Dm644 completions/flexfetch.bash "$pkgdir/usr/share/bash-completion/completions/flexfetch"
  install -Dm644 completions/flexfetch.zsh "$pkgdir/usr/share/zsh/site-functions/_flexfetch"
  install -Dm644 completions/flexfetch.fish "$pkgdir/usr/share/fish/vendor_completions.d/flexfetch.fish"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
