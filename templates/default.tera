{%- if title -%}
{%- if theme_gradient -%}
{{ theme_title_gradient }}{{ theme_reset }}
{%- else -%}
{{ theme_title }}{{ title }}{{ theme_reset }}
{%- endif %}
{{ theme_sep }}────────────────────────────{{ theme_reset }}
{%- endif -%}

{%- if os %}
├─{{ icon_os }} OS: {{ os.pretty_name | default(value=os.name | default(value="")) }}
{%- endif %}
{%- if kernel %}
├─{{ icon_kernel }} Kernel: {{ kernel }}
{%- endif %}
{%- if host %}
├─{{ icon_host }} Host: {{ host }}
{%- endif %}
{%- if uptime %}
├─{{ icon_uptime }} Uptime: {{ uptime }}
{%- endif %}
{%- if locale %}
├─{{ icon_locale }} Locale: {{ locale.lang | default(value="") }}{% if locale.encoding %} ({{ locale.encoding }}){% endif %}
{%- endif %}
{%- if cpu %}
├─{{ icon_cpu }} CPU: {{ cpu.model }} ({{ cpu.cores }} cores) @ {{ cpu.freq_mhz }} MHz{% if cpu.temp %} | {{ cpu.temp }}{% endif %}
{%- endif %}
{%- if gpu and gpu|length > 0 %}
{%- for device in gpu %}
├─{{ icon_gpu }} GPU: {{ device }}
{%- endfor %}
{%- endif %}
{%- if memory %}
├─{{ icon_memory }} Memory: {{ memory.used }} / {{ memory.total }} ({{ memory.percent }})
{%- if memory.swap_percent %}
├─{{ icon_swap }} Swap: {{ memory.swap_used }} / {{ memory.swap_total }} ({{ memory.swap_percent }})
{%- else %}
├─{{ icon_memory }} Memory: {{ memory.used }} / {{ memory.total }} ({{ memory.percent }})
{%- endif %}
{%- else %}
{%- if memory.swap_percent %}
├─{{ icon_swap }} Swap: {{ memory.swap_used }} / {{ memory.swap_total }} ({{ memory.swap_percent }})
{%- endif %}
{%- endif %}
{%- if disk %}
{%- for mount in disk %}
├─{{ icon_disk }} {{ mount }}
{%- endfor %}
{%- else %}
├─{{ icon_disk }} Disk: N/A
{%- endif %}

{%- if network %}
├─{{ icon_network }} Network:
{%- for iface in network %}
├───{{ icon_interface }} {{ iface.name }}: {{ iface.ipv4 }}{% if iface.ipv6 %}, {{ iface.ipv6 }}{% endif %}{% if iface.mac %} [{{ iface.mac }}]{% endif %}
{%- endfor %}
{%- endif %}

{%- if resolution %}
├─{{ icon_resolution }} Resolution: {{ resolution }}
{%- endif %}
{%- if battery %}
{%- if battery.percent %}
├─{{ icon_battery }} Battery: {{ battery.percent }}{% if battery.status %} ({{ battery.status }}){% endif %}
{%- else %}
├─{{ icon_battery }} Battery: {{ battery }}
{%- endif %}
{%- endif %}
{%- if processes %}
╰─{{ icon_processes }} Processes: {{ processes }}
{%- else %}
╰─{{ icon_end }} 
{%- endif %}