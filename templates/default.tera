{%- endif %}
{%- if cpu %}
{{ theme_keys }}{{ icon_cpu }}{{ "CPU" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{{ cpu.model }} ({{ cpu.cores }} cores) @ {{ cpu.freq_mhz }} MHz{% if cpu.temp %} | {{ cpu.temp }}{% endif %}{{ theme_reset }}
