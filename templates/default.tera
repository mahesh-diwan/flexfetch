{%- if container and container.id %}
{{ theme_keys }}{{ icon_container | default(value="󰡨 ") }}{{ "Container" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{{ container.runtime | default(value="?") }}{% if container.id %} [{{ container.id }}]{% endif %}{% if container.image %} — {{ container.image }}{% endif %}{% if container.k8s_namespace %} | K8s {{ container.k8s_namespace }}{% if container.k8s_pod %}/{{ container.k8s_pod }}{% endif %}{% endif %}{{ theme_reset }}
{%- endif %}
{%- if wallpaper and wallpaper.path %}
{{ theme_keys }}{{ icon_wallpaper | default(value="󰋲 ") }}{{ "Wallpaper" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{{ wallpaper.path }}{% if wallpaper.gtk_theme %} | {{ wallpaper.gtk_theme }}{% endif %}{{ theme_reset }}
{%- endif %}
{%- if weather and weather.temperature %}
{{ theme_keys }}{{ icon_weather | default(value="󰖕 ") }}{{ "Weather" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{{ weather.symbol | default(value="") }} {{ weather.temperature }}{% if weather.humidity %} {{ weather.humidity }}{% endif %}{% if weather.wind %} {{ weather.wind }}{% endif %}{% if weather.city %} — {{ weather.city }}{% endif %}{{ theme_reset }}
{%- endif %}
