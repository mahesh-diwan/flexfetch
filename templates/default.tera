{%- if title -%}
{%- if theme_gradient -%}
{{ theme_title_gradient }}{{ theme_reset }}
{%- else -%}
{{ theme_title }}{{ title }}{{ theme_reset }}
{%- endif %}
{{ theme_sep }}────────────────────────────{{ theme_reset }}
{%- endif -%}

{%- if os %}
├─{{ icon_os }} OS: {{ os.pretty_name | default(value=os.name | default(value="")) }}
{%- endif %}
{%- if kernel %}
├─{{ icon_kernel }} Kernel: {{ kernel }}
{%- endif %}
{%- if host %}
├─{{ icon_host }} Host: {{ host }}
{%- endif %}
{%- if uptime %}
├─{{ icon_uptime }} Uptime: {{ uptime }}
{%- endif %}
{%- if locale %}
├─{{ icon_locale }} Locale: {{ locale.lang | default(value="") }}{% if locale.encoding %} ({{ locale.encoding }}){% endif %}
{%- endif %}
{%- if project %}
├─{{ icon_project | default(value="󰚩") }} Project: {{ project.type }}{% if project.name %} — {{ project.name }}{% endif %}
{%- endif %}
{%- if git %}
├─{{ icon_git | default(value="󰊢") }} Git: {{ git.branch }}{% if git.ahead %} ↑{{ git.ahead }}{% endif %}{% if git.behind %} ↓{{ git.behind }}{% endif %}{% if git.dirty %} [{{ git.dirty }} dirty]{% endif %}
{%- endif %}
{%- if context %}
{%- if context.container %}
├─{{ icon_container | default(value="󰡨") }} Container: {{ context.container }}
{%- endif %}
{%- if context.venv %}
├─{{ icon_venv | default(value="󰌠") }} Virtualenv: {{ context.venv }}
{%- endif %}
{%- if context.ssh %}
├─{{ icon_ssh | default(value="󰇧") }} SSH: {{ context.ssh }}
{%- endif %}
{%- endif %}
{%- if health %}
├─{{ icon_health | default(value="󰐗") }} Health: {{ health.score }}/100 ({{ health.grade }}){% if health.notes %} — {{ health.notes }}{% endif %}
{%- endif %}
{%- if container and container.id %}
├─{{ icon_container | default(value="󰡨") }} Container: {{ container.runtime | default(value="?") }}{% if container.id %} [{{ container.id }}]{% endif %}{% if container.image %} — {{ container.image }}{% endif %}{% if container.k8s_namespace %} | K8s {{ container.k8s_namespace }}{% if container.k8s_pod %}/{{ container.k8s_pod }}{% endif %}{% endif %}
{%- endif %}
{%- if wallpaper and wallpaper.path %}
├─{{ icon_wallpaper | default(value="󰋲") }} Wallpaper: {{ wallpaper.path }}{% if wallpaper.gtk_theme %} | {{ wallpaper.gtk_theme }}{% endif %}
{%- endif %}
{%- if weather and weather.temperature %}
├─{{ icon_weather | default(value="󰖕") }} Weather: {{ weather.symbol | default(value="") }} {{ weather.temperature }}{% if weather.humidity %} {{ weather.humidity }}{% endif %}{% if weather.wind %} {{ weather.wind }}{% endif %}{% if weather.city %} — {{ weather.city }}{% endif %}
{%- endif %}
{%- if fsdeep and fsdeep|length > 0 %}
├─{{ icon_disk | default(value="󰋊") }} Storage: {% if fsdeep.zram_ratio %}ZRAM {{ fsdeep.zram_ratio }}{% endif %}{% if fsdeep.luks_devices %} | LUKS {{ fsdeep.luks_devices }}{% endif %}{% if fsdeep.btrfs_compression %} | BTRFS {{ fsdeep.btrfs_compression }}{% if fsdeep.btrfs_filesystems %} ({{ fsdeep.btrfs_filesystems }}){% endif %}{% endif %}{% if fsdeep.lvm_volumes %} | LVM {{ fsdeep.lvm_volumes }}{% endif %}
{%- endif %}
{%- if terminal and terminal.image_protocols %}
├─{{ icon_terminal | default(value="󰆍") }} Terminal: {{ terminal.name }}{% if terminal.font %} | {{ terminal.font }}{% endif %}{% if terminal.truecolor %} | truecolor{% endif %}{% if terminal.image_protocols %} | {{ terminal.image_protocols }}{% endif %}
{%- endif %}
{%- if cpu %}
├─{{ icon_cpu }} CPU: {{ cpu.model }} ({{ cpu.cores }} cores) @ {{ cpu.freq_mhz }} MHz{% if cpu.temp %} | {{ cpu.temp }}{% endif %}
{%- endif %}
{%- if cpucache and cpucache|length > 0 %}
├─{{ icon_cpu | default(value="󰍛") }} Cache: {% if cpucache.l1d %}L1d {{ cpucache.l1d }}{% endif %}{% if cpucache.l1i %} L1i {{ cpucache.l1i }}{% endif %}{% if cpucache.l2 %} L2 {{ cpucache.l2 }}{% endif %}{% if cpucache.l3 %} L3 {{ cpucache.l3 }}{% endif %}
{%- endif %}
{%- if cpuusage %}
├─{{ icon_cpu | default(value="󰍛") }} CPU Usage: {{ cpuusage }}
{%- endif %}
{%- if gpu and gpu|length > 0 %}
{%- for device in gpu %}
├─{{ icon_gpu }} GPU: {{ device }}
{%- endfor %}
{%- endif %}
{%- if memory %}
├─{{ icon_memory }} Memory: {{ memory.used }} / {{ memory.total }} ({{ memory.percent }})
{%- if memory.swap_percent %}
├─{{ icon_swap }} Swap: {{ memory.swap_used }} / {{ memory.swap_total }} ({{ memory.swap_percent }})
{%- endif %}
{%- else %}
{%- if memory.swap_percent %}
├─{{ icon_swap }} Swap: {{ memory.swap_used }} / {{ memory.swap_total }} ({{ memory.swap_percent }})
{%- endif %}
{%- endif %}
{%- for mount in disk %}
├─{{ icon_disk }} {{ mount }}
{%- endfor %}

{%- if network %}
├─{{ icon_network }} Network:
{%- for iface in network %}
├───{{ icon_interface }} {{ iface.name }}: {{ iface.ipv4 }}{% if iface.ipv6 %}, {{ iface.ipv6 }}{% endif %}{% if iface.mac %} [{{ iface.mac }}]{% endif %}
{%- endfor %}
{%- endif %}

{%- if resolution %}
├─{{ icon_resolution }} Resolution: {{ resolution }}
{%- endif %}
{%- if display %}
├─{{ icon_resolution | default(value="󰍹") }} Display: {{ display }}
{%- endif %}
{%- if wifi and wifi.ssid %}
├─{{ icon_network | default(value="󰤨") }} WiFi: {{ wifi.ssid }}{% if wifi.signal %} {{ wifi.signal }}{% endif %}{% if wifi.frequency %} {{ wifi.frequency }}{% endif %}{% if wifi.security %} [{{ wifi.security }}]{% endif %}
{%- endif %}
{%- if publicip and publicip != "unknown" %}
├─{{ icon_network | default(value="󰖟") }} Public IP: {{ publicip }}
{%- endif %}
{%- if battery %}
{%- if battery.percent %}
├─{{ icon_battery }} Battery: {{ battery.percent }}{% if battery.status %} ({{ battery.status }}){% endif %}
{%- else %}
├─{{ icon_battery }} Battery: {{ battery }}
{%- endif %}
{%- endif %}
{%- if temperature and temperature != "unknown" %}
{%- if temperature.cpu %}
├─{{ icon_temp | default(value="󰏗") }} Temp: CPU {{ temperature.cpu }}{% if temperature.gpu %} | GPU {{ temperature.gpu }}{% endif %}{% if temperature.fan %} | Fan {{ temperature.fan }}{% endif %}
{%- endif %}
{%- endif %}
{%- if bluetooth and bluetooth.adapter %}
├─{{ icon_bluetooth | default(value="󰂯") }} Bluetooth: {{ bluetooth.adapter }} [{{ bluetooth.state }}]{% if bluetooth.devices %} — {{ bluetooth.devices }}{% endif %}
{%- elif bluetooth %}
├─{{ icon_bluetooth | default(value="󰂯") }} Bluetooth: {{ bluetooth }}
{%- endif %}
{%- if media and media.player %}
├─{{ icon_media | default(value="󰎆") }} Media: {% if media.artist %}{{ media.artist }}{% if media.title %} — {{ media.title }}{% endif %}{% elif media.title %}{{ media.title }}{% else %}{{ media.player }}{% endif %}{% if media.status %} [{{ media.status }}]{% endif %}
{%- endif %}
{%- if processes %}
╰─{{ icon_processes }} Processes: {{ processes }}
{%- else %}
╰─{{ icon_end }} 
{%- endif %}