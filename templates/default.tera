{{ theme_keys }}{{ icon_terminal | default(value="󰆍 ") }}{{ "Terminal" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{{ terminal.name }}{% if terminal.font %} | {{ terminal.font }}{% endif %}{% if terminal.truecolor %} | truecolor{% endif %}{% if terminal.image_protocols %} | {{ terminal.image_protocols }}{% endif %}{{ theme_reset }}
{%- endif %}
{%- if de and de != "unknown" %}
{{ theme_keys }}{{ icon_de | default(value="󰍹 ") }}{{ "DE" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{{ de }}{{ theme_reset }}
{%- endif %}
