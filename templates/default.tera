{%- if memory %}
{{ theme_keys }}{{ icon_memory }}{{ "Memory" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{{ memory.used }} / {{ memory.total }} ({{ memory.percent }}){{ theme_reset }}
{%- if memory.swap_percent %}
{{ theme_keys }}{{ icon_swap }}{{ "Swap" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{{ memory.swap_used }} / {{ memory.swap_total }} ({{ memory.swap_percent }}){{ theme_reset }}
{%- endif %}
{%- else %}
{%- if memory.swap_percent %}
{{ theme_keys }}{{ icon_swap }}{{ "Swap" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{{ memory.swap_used }} / {{ memory.swap_total }} ({{ memory.swap_percent }}){{ theme_reset }}
{%- endif %}
{%- endif %}
