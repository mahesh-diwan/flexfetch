{{ theme_keys }}{{ icon_disk | default(value="󰋊 ") }}{{ "Storage" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{% if fsdeep.zram_ratio %}ZRAM {{ fsdeep.zram_ratio }}{% endif %}{% if fsdeep.luks_devices %} | LUKS {{ fsdeep.luks_devices }}{% endif %}{% if fsdeep.btrfs_compression %} | BTRFS {{ fsdeep.btrfs_compression }}{% if fsdeep.btrfs_filesystems %} ({{ fsdeep.btrfs_filesystems }}){% endif %}{% endif %}{% if fsdeep.lvm_volumes %} | LVM {{ fsdeep.lvm_volumes }}{% endif %}{{ theme_reset }}
{%- endif %}
