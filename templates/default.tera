{%- if title -%}
{%- if theme_gradient -%}
{{ theme_title_gradient }}{{ theme_reset }}
{%- else -%}
{{ theme_title }}{{ title }}{{ theme_reset }}
{%- endif %}
{{ theme_sep }}────────────────────────────{{ theme_reset }}
{%- endif -%}

{%- if os %}
{{ theme_keys }}{{ icon_os }}{{ "OS" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{{ os.pretty_name | default(value=os.name | default(value="")) }}{{ theme_reset }}
{%- endif %}
{%- if kernel %}
{{ theme_keys }}{{ icon_kernel }}{{ "Kernel" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{{ kernel }}{{ theme_reset }}
{%- endif %}
