{%- endif %}
{%- if project %}
{{ theme_keys }}{{ icon_project | default(value="󰚩 ") }}{{ "Project" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{{ project.type }}{% if project.name %} — {{ project.name }}{% endif %}{{ theme_reset }}
{%- endif %}
{%- if git %}
{{ theme_keys }}{{ icon_git | default(value="󰊢 ") }}{{ "Git" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{{ git.branch }}{% if git.ahead %} ↑{{ git.ahead }}{% endif %}{% if git.behind %} ↓{{ git.behind }}{% endif %}{% if git.dirty %} [{{ git.dirty }} dirty]{% endif %}{{ theme_reset }}
