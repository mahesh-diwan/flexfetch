{%- if health %}
{{ theme_keys }}{{ icon_health | default(value="󰐗 ") }}{{ "Health" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{{ health.score }}/100 ({{ health.grade }}){% if health.notes %} — {{ health.notes }}{% endif %}{{ theme_reset }}
