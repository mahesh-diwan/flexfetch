{%- endif %}
{%- if gpu and gpu|length > 0 %}
{%- for device in gpu %}
{{ theme_keys }}{{ icon_gpu }}{{ "GPU" | pad(width=display_key_width) }}{{ theme_sep }}{{ display_separator }}{{ theme_values }}{{ device }}{{ theme_reset }}
