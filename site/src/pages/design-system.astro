---
import Layout from '../layouts/Layout.astro';
const semantic = [
  { name: '--color-bg', slot: 'bg' },
  { name: '--color-bg-subtle', slot: 'bg-subtle' },
  { name: '--color-surface', slot: 'surface' },
  { name: '--color-surface-raised', slot: 'surface-raised' },
  { name: '--color-surface-overlay', slot: 'surface-overlay' },
  { name: '--color-fg', slot: 'fg' },
  { name: '--color-fg-muted', slot: 'fg-muted' },
  { name: '--color-fg-subtle', slot: 'fg-subtle' },
  { name: '--color-fg-on-accent', slot: 'fg-on-accent' },
  { name: '--color-border', slot: 'border' },
  { name: '--color-border-subtle', slot: 'border-subtle' },
  { name: '--color-border-strong', slot: 'border-strong' },
  { name: '--color-accent', slot: 'accent' },
  { name: '--color-accent-hover', slot: 'accent-hover' },
  { name: '--color-accent-subtle', slot: 'accent-subtle' },
  { name: '--color-focus-ring', slot: 'focus-ring' },
  { name: '--color-success', slot: 'success' },
  { name: '--color-warning', slot: 'warning' },
  { name: '--color-danger', slot: 'danger' },
  { name: '--color-info', slot: 'info' },
];
const neutrals = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
const brands = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900];
const radii = [
  { name: 'none', v: 'var(--radius-none)' },
  { name: 'xs', v: 'var(--radius-xs)' },
  { name: 'sm', v: 'var(--radius-sm)' },
  { name: 'md', v: 'var(--radius-md)' },
  { name: 'lg', v: 'var(--radius-lg)' },
  { name: 'xl', v: 'var(--radius-xl)' },
  { name: '2xl', v: 'var(--radius-2xl)' },
  { name: '3xl', v: 'var(--radius-3xl)' },
  { name: 'full', v: 'var(--radius-full)' },
];
const durations = [
  { name: 'instant', v: 'var(--duration-instant)' },
  { name: 'fast', v: 'var(--duration-fast)' },
  { name: 'base', v: 'var(--duration-base)' },
  { name: 'slow', v: 'var(--duration-slow)' },
  { name: 'slower', v: 'var(--duration-slower)' },
];
const textSizes = [
  { name: 'xs', v: 'var(--text-xs)' },
  { name: 'sm', v: 'var(--text-sm)' },
  { name: 'base', v: 'var(--text-base)' },
  { name: 'lg', v: 'var(--text-lg)' },
  { name: 'xl', v: 'var(--text-xl)' },
  { name: '2xl', v: 'var(--text-2xl)' },
  { name: '3xl', v: 'var(--text-3xl)' },
  { name: '4xl', v: 'var(--text-4xl)' },
];
const stacks = [
  { name: 'xs', v: 'var(--stack-xs)' },
  { name: 'sm', v: 'var(--stack-sm)' },
  { name: 'md', v: 'var(--stack-md)' },
  { name: 'lg', v: 'var(--stack-lg)' },
  { name: 'xl', v: 'var(--stack-xl)' },
  { name: '2xl', v: 'var(--stack-2xl)' },
];
const breakpoints = [
  { name: 'xs', min: '0', dev: 'iPhone SE, small Android' },
  { name: 'sm', min: '640px', dev: 'iPhone Pro Max, large Android' },
  { name: 'md', min: '768px', dev: 'iPad portrait' },
  { name: 'lg', min: '1024px', dev: 'iPad landscape, small laptop' },
  { name: 'xl', min: '1280px', dev: 'Desktop' },
  { name: '2xl', min: '1536px', dev: 'Large desktop, ultra-wide entry' },
];
const shadows = [
  { name: 'xs', v: 'var(--shadow-xs)' },
  { name: 'sm', v: 'var(--shadow-sm)' },
  { name: 'md', v: 'var(--shadow-md)' },
  { name: 'lg', v: 'var(--shadow-lg)' },
  { name: 'xl', v: 'var(--shadow-xl)' },
  { name: 'inner', v: 'var(--shadow-inner)' },
];
const insets = [
  { name: 'xs', v: 'var(--inset-xs)' },
  { name: 'sm', v: 'var(--inset-sm)' },
  { name: 'md', v: 'var(--inset-md)' },
  { name: 'lg', v: 'var(--inset-lg)' },
  { name: 'xl', v: 'var(--inset-xl)' },
];
---

<Layout title="Design System: flexfetch">
  <section class="section" style="padding-top: 120px;">
    <div class="container">
      <header class="ds-head">
        <p class="eyebrow">Design System</p>
        <h1>Flexfetch token layer</h1>
        <p class="ds-lede">
          Every token declared in <code>DESIGN.md</code>, rendered live from
          <code>theme.css</code>. Values come from CSS variables, so this page auto-updates
          when the theme is regenerated. Resize the window — the viewport indicator in the
          bottom-right tracks breakpoints in real time.
        </p>
      </header>

      <!-- ============ PRIMITIVES ============ -->
      <section class="ds-sec" id="primitives">
        <h2>Primitive palette</h2>
        <p class="ds-sub">Raw values. Components reference the semantic layer, never primitives.</p>
        <h3 class="ds-grp">Neutral</h3>
        <div class="sw-grid">
          {neutrals.map((n) => (
            <div class="sw">
              <i class="sw-bg" style={`background: var(--color-neutral-${n})`}></i>
              <span>neutral-{n}</span>
              <code>var(--color-neutral-{n})</code>
            </div>
          ))}
        </div>
        <h3 class="ds-grp">Brand</h3>
        <div class="sw-grid">
          {brands.map((n) => (
            <div class="sw">
              <i class="sw-bg" style={`background: var(--color-brand-${n})`}></i>
              <span>brand-{n}</span>
              <code>var(--color-brand-{n})</code>
            </div>
          ))}
        </div>
        <h3 class="ds-grp">Status</h3>
        <div class="sw-grid">
          {['success', 'warning', 'danger', 'info'].map((s) => (
            <div class="sw">
              <i class="sw-bg" style={`background: var(--color-status-${s}-500)`}></i>
              <span>{s}-500</span>
              <code>var(--color-status-{s}-500)</code>
            </div>
          ))}
        </div>
      </section>

      <!-- ============ SEMANTIC ============ -->
      <section class="ds-sec" id="semantic">
        <h2>Semantic colors</h2>
        <p class="ds-sub">The layer component code references. Dark mode is active on this site.</p>
        <div class="sem-grid">
          {semantic.map((s) => (
            <div class="sem">
              <i class="sem-bg" style={`background: ${s.slot === 'border' ? 'var(--color-border)' : s.slot === 'border-subtle' ? 'var(--color-border-subtle)' : s.slot === 'border-strong' ? 'var(--color-border-strong)' : s.slot === 'surface-overlay' ? 'var(--color-surface-overlay)' : s.slot === 'fg-on-accent' ? 'var(--color-fg-on-accent)' : `var(--color-${s.slot})`}`}></i>
              <div class="sem-txt">
                <code>{s.name}</code>
                <span>var({s.name})</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ============ TYPOGRAPHY ============ -->
      <section class="ds-sec" id="typography">
        <h2>Typography</h2>
        <p class="ds-sub">Fluid type scale — sans: Inter, display: JetBrains Mono.</p>
        <div class="type-list">
          {textSizes.map((t) => (
            <div class="type-row">
              <code class="type-meta">{t.name} · {t.v}</code>
              <span class="type-samp" style={`font-size: ${t.v}`}>The quick brown fox jumps over the lazy dog</span>
            </div>
          ))}
        </div>
      </section>

      <!-- ============ SPACING ============ -->
      <section class="ds-sec" id="spacing">
        <h2>Spacing</h2>
        <p class="ds-sub">Inset (container padding), stack (vertical gap), inline (horizontal gap).</p>
        <h3 class="ds-grp">inset</h3>
        <div class="gap-list">
          {insets.map((x) => (
            <div class="gap-row">
              <code>{x.name}</code>
              <span class="gap-bar" style={`width: ${x.v}`}></span>
              <code class="gap-v">{x.v}</code>
            </div>
          ))}
        </div>
        <h3 class="ds-grp">stack</h3>
        <div class="gap-list">
          {stacks.map((x) => (
            <div class="gap-row">
              <code>{x.name}</code>
              <span class="gap-bar" style={`width: ${x.v}`}></span>
              <code class="gap-v">{x.v}</code>
            </div>
          ))}
        </div>
      </section>

      <!-- ============ RADIUS ============ -->
      <section class="ds-sec" id="radius">
        <h2>Border radius</h2>
        <div class="sw-grid">
          {radii.map((r) => (
            <div class="sw">
              <i class="rbox" style={`border-radius: ${r.v}`}></i>
              <span>{r.name}</span>
              <code>{r.v}</code>
            </div>
          ))}
        </div>
      </section>

      <!-- ============ SHADOW ============ -->
      <section class="ds-sec" id="shadow">
        <h2>Elevation</h2>
        <div class="sw-grid">
          {shadows.map((s) => (
            <div class="sw">
              <i class="sbox" style={`box-shadow: ${s.v}`}></i>
              <span>{s.name}</span>
              <code>{s.v}</code>
            </div>
          ))}
        </div>
      </section>

      <!-- ============ MOTION ============ -->
      <section class="ds-sec" id="motion">
        <h2>Motion</h2>
        <p class="ds-sub">Transform + opacity only, guarded by prefers-reduced-motion. Hover to feel each duration.</p>
        <div class="sw-grid">
          {durations.map((d) => (
            <button class="dur" type="button" style={`transition-duration: ${d.v}`}>
              <b>{d.name}</b>
              <span>{d.v}</span>
            </button>
          ))}
        </div>
      </section>

      <!-- ============ BREAKPOINTS ============ -->
      <section class="ds-sec" id="responsive">
        <h2>Responsive breakpoints</h2>
        <div class="bp-wrap">
          <table class="bp-table">
            <thead>
              <tr><th>Name</th><th>Min width</th><th>Devices</th></tr>
            </thead>
            <tbody>
              {breakpoints.map((b) => (
                <tr>
                  <td><code>{b.name}</code></td>
                  <td>{b.min}</td>
                  <td>{b.dev}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </section>

  <div class="vp" id="vp" aria-hidden="true"></div>

  <script>
    const vp = document.getElementById("vp");
    const update = () => {
      const w = window.innerWidth;
      const bp =
        w < 640 ? "xs" :
        w < 768 ? "sm" :
        w < 1024 ? "md" :
        w < 1280 ? "lg" :
        w < 1536 ? "xl" : "2xl";
      vp.textContent = `viewport ${w}px · ${bp}`;
    };
    update();
    window.addEventListener("resize", update, { passive: true });
  </script>
</Layout>

<style>
  .ds-head { margin-bottom: 48px; }
  .ds-head h1 { font-family: var(--font-display); font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem); letter-spacing: -0.03em; color: var(--ink); margin: 8px 0 16px; }
  .ds-lede { max-width: 620px; color: var(--faint); font-size: 14px; line-height: 1.7; }
  .ds-lede code, .ds-grp code { font-family: var(--font-mono); font-size: 12px; color: var(--spot); }

  .ds-sec { margin-bottom: 64px; scroll-margin-top: 90px; }
  .ds-sec h2 { font-family: var(--font-display); font-size: 18px; font-weight: 600; color: var(--ink); margin-bottom: 4px; }
  .ds-sub { color: var(--faint); font-size: 13px; margin-bottom: 20px; }
  .ds-grp { font: 500 11px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint2); margin: 28px 0 12px; }

  .sw-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
  .sw { border: 1px solid var(--line2); border-radius: var(--radius-md); padding: 12px; background: var(--panel); display: flex; flex-direction: column; gap: 8px; }
  .sw-bg { height: 48px; border-radius: var(--radius-sm); border: 1px solid var(--line); display: block; }
  .sw span { font: 500 12px var(--font-mono); color: var(--ink); }
  .sw code { font-size: 10px; color: var(--faint); word-break: break-all; }

  .sem-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
  .sem { display: flex; align-items: center; gap: 12px; border: 1px solid var(--line2); border-radius: var(--radius-md); padding: 10px 12px; background: var(--panel); }
  .sem-bg { width: 28px; height: 28px; border-radius: var(--radius-sm); border: 1px solid var(--line); flex-shrink: 0; }
  .sem-txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .sem-txt code { font-size: 12px; color: var(--ink); white-space: nowrap; }
  .sem-txt span { font-size: 10px; color: var(--faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .type-list { border: 1px solid var(--line2); border-radius: var(--radius-md); overflow: hidden; }
  .type-row { display: flex; align-items: baseline; gap: 16px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
  .type-row:last-child { border-bottom: 0; }
  .type-meta { font-size: 11px; color: var(--faint); width: 140px; flex-shrink: 0; }
  .type-samp { color: var(--ink); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .gap-list { display: flex; flex-direction: column; gap: 8px; max-width: 560px; }
  .gap-row { display: flex; align-items: center; gap: 12px; }
  .gap-row code { font-size: 11px; color: var(--faint); width: 40px; }
  .gap-bar { height: 12px; border-radius: var(--radius-xs); background: var(--spot); flex-shrink: 0; }
  .gap-v { font-size: 10px; color: var(--faint2); }

  .rbox { height: 48px; border: 1px solid var(--line2); background: var(--mass); display: block; }

  .sbox { height: 56px; border-radius: var(--radius-md); background: var(--mass); display: block; }

  .dur { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: 16px; border: 1px solid var(--line2); border-radius: var(--radius-md); background: var(--panel); color: var(--ink); cursor: pointer; min-height: 64px; transition: transform var(--ease-out), background var(--duration-fast) var(--ease-out); }
  .dur:hover { transform: scale(1.02); background: var(--mass); }
  .dur:active { transform: scale(0.98); }
  .dur b { font: 500 12px var(--font-mono); }
  .dur span { font-size: 10px; color: var(--faint); }

  .bp-wrap { border: 1px solid var(--line2); border-radius: var(--radius-md); overflow-x: auto; }
  .bp-table { width: 100%; border-collapse: collapse; }
  .bp-table th { text-align: left; font: 500 11px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); padding: 10px 16px; border-bottom: 1px solid var(--line2); }
  .bp-table td { padding: 10px 16px; font-size: 13px; color: var(--dim); border-bottom: 1px solid var(--line); }
  .bp-table tr:last-child td { border-bottom: 0; }
  .bp-table td code { font-size: 12px; color: var(--spot); }

  .vp { position: fixed; bottom: 16px; right: 16px; z-index: 60; padding: 8px 12px; font: 11px var(--font-mono); color: var(--ink); background: color-mix(in srgb, var(--color-surface-raised) 92%, transparent); border: 1px solid var(--line2); border-radius: var(--radius-md); backdrop-filter: blur(8px); box-shadow: var(--shadow-lg); }

  @media (max-width: 640px) {
    .type-meta { width: 100px; }
    .vp { bottom: 8px; right: 8px; }
  }
</style>
