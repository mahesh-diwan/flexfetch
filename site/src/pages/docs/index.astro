---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const docs = await getCollection('docs');
---

<Layout title="Documentation: flexfetch">
  <section class="section" style="padding-top: 120px;">
    <div class="container">
      <div class="docs-grid">
        <nav class="docs-sidebar" aria-label="Documentation">
          <ul>
            {docs.map((entry) => (
              <li>
                <a href={`${import.meta.env.BASE_URL}/docs/${entry.slug}/`}>
                  {entry.data.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="docs-content">
          <h1>Documentation</h1>
          <p class="lead">flexfetch is a blazing-fast, themeable system info tool for Linux and macOS. Built in pure Rust.</p>

          <div class="doc-cards">
            {docs.map((entry) => (
              <a href={`${import.meta.env.BASE_URL}/docs/${entry.slug}/`} class="doc-card">
                <span class="doc-card-n">{String(docs.indexOf(entry) + 1).padStart(2, '0')}</span>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .docs-grid {
      display: grid;
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 56px;
      align-items: start;
    }
    .docs-sidebar {
      position: sticky;
      top: 84px;
      max-height: calc(100vh - 108px);
      overflow-y: auto;
      border-right: 1px solid var(--line);
      padding-right: 20px;
    }
    .docs-sidebar ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .docs-sidebar li {
      margin-bottom: 2px;
    }
    .docs-sidebar a {
      display: block;
      padding: 7px 10px;
      border: 1px solid transparent;
      border-radius: var(--radius);
      font: 500 12px var(--font-mono);
      color: var(--faint2);
      transition:
        color var(--duration-fast) var(--ease-out),
        background var(--duration-fast) var(--ease-out),
        border-color var(--duration-fast) var(--ease-out);
    }
    .docs-sidebar a:hover {
      color: var(--ink);
      background: var(--panel);
    }

    .docs-content {
      max-width: 720px;
    }
    .docs-content h1 {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: clamp(30px, 4vw, 40px);
      letter-spacing: -0.01em;
      line-height: 1.08;
      color: var(--ink);
      margin: 0 0 12px;
      text-wrap: balance;
    }
    .lead {
      color: var(--faint);
      font-size: 17px;
      line-height: 1.6;
      margin-bottom: 40px;
      text-wrap: pretty;
    }

    .doc-cards {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .doc-card {
      display: block;
      padding: 18px;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 6px;
      transition:
        border-color var(--duration-fast) var(--ease-out),
        background var(--duration-fast) var(--ease-out);
    }
    .doc-card:hover {
      border-color: var(--line2);
      background: var(--mass);
    }
    .doc-card-n {
      display: block;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 18px;
      letter-spacing: -0.02em;
      color: var(--faint2);
      margin-bottom: 10px;
    }
    .doc-card:hover .doc-card-n {
      color: var(--spot);
    }
    .doc-card h3 {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 16px;
      letter-spacing: -0.01em;
      color: var(--ink);
      margin-bottom: 6px;
    }
    .doc-card p {
      font-size: 13px;
      color: var(--faint);
      line-height: 1.55;
    }

    @media (max-width: 1024px) {
      .docs-grid {
        grid-template-columns: 200px minmax(0, 1fr);
        gap: 32px;
      }
    }
    @media (max-width: 768px) {
      .docs-grid {
        grid-template-columns: 1fr;
      }
      .docs-sidebar {
        display: none;
      }
      .doc-cards {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
