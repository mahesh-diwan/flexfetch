---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { slug: doc.slug },
    props: { entry: doc },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const docs = await getCollection('docs');
const idx = docs.findIndex((d) => d.slug === entry.slug);
const prev = idx > 0 ? docs[idx - 1] : null;
const next = idx < docs.length - 1 ? docs[idx + 1] : null;
---

<Layout title={`${entry.data.title}: flexfetch`} description={entry.data.description}>
  <section class="section" style="padding-top: 120px;">
    <div class="container">
      <div class="docs-grid">
        <nav class="docs-sidebar" aria-label="Documentation">
          <ul>
            {docs.map((e) => (
              <li>
                <a href={`${import.meta.env.BASE_URL}/docs/${e.slug}/`} class={e.slug === entry.slug ? 'active' : ''}>
                  {e.data.title}
                </a>
              </li>
            ))}
          </ul>
          <div class="toc-desk" data-toc hidden>
            <p class="toc-label">On this page</p>
            <ol data-toc-list></ol>
          </div>
        </nav>

        <article class="docs-content">
          <p class="crumb">
            <a href={`${import.meta.env.BASE_URL}/docs/`}>Docs</a>
            <span aria-hidden="true">/</span>
            {entry.data.title}
          </p>
          <h1>{entry.data.title}</h1>
          <p class="lead">{entry.data.description}</p>
          <nav class="toc-mob" data-toc-mobile hidden aria-label="On this page">
            <details>
              <summary>On this page</summary>
              <ol data-toc-list></ol>
            </details>
          </nav>
          <Content />
        </article>
      </div>

      <nav class="docs-next" aria-label="Documentation pages">
        {prev ? (
          <a href={`${import.meta.env.BASE_URL}/docs/${prev.slug}/`} class="docs-next-item">
            <span>← Prev</span>
            <strong>{prev.data.title}</strong>
          </a>
        ) : (
          <span class="docs-next-item empty"></span>
        )}
        {next ? (
          <a href={`${import.meta.env.BASE_URL}/docs/${next.slug}/`} class="docs-next-item right">
            <span>Next →</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : (
          <span class="docs-next-item empty right"></span>
        )}
      </nav>
    </div>
  </section>

  <style is:global>
    .docs-grid {
      display: grid;
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 56px;
      align-items: start;
    }

    /* ---------- sidebar ---------- */
    .docs-sidebar {
      position: sticky;
      top: 84px;
      max-height: calc(100vh - 108px);
      overflow-y: auto;
      border-right: 1px solid var(--line);
      padding-right: 20px;
    }
    .docs-sidebar ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .docs-sidebar li {
      margin-bottom: 2px;
    }
    .docs-sidebar a {
      display: block;
      padding: 7px 10px;
      border: 1px solid transparent;
      border-radius: var(--radius);
      font: 500 12px var(--font-mono);
      color: var(--faint2);
      transition:
        color var(--duration-fast) var(--ease-out),
        background var(--duration-fast) var(--ease-out),
        border-color var(--duration-fast) var(--ease-out);
    }
    .docs-sidebar a:hover {
      color: var(--ink);
      background: var(--panel);
    }
    .docs-sidebar a.active {
      color: var(--spot);
      background: color-mix(in srgb, var(--color-accent) 8%, transparent);
      border-color: color-mix(in srgb, var(--color-accent) 25%, transparent);
    }

    /* ---------- on-this-page ---------- */
    .toc-desk {
      margin-top: 28px;
      padding-top: 20px;
      border-top: 1px solid var(--line);
    }
    .toc-label {
      font: 500 10px var(--font-mono);
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--faint2);
      margin-bottom: 12px;
    }
    .toc-desk ol,
    .toc-mob ol {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .toc-desk li {
      margin-bottom: 2px;
    }
    .toc-desk a {
      display: block;
      padding: 4px 10px;
      border-left: 2px solid transparent;
      font: 11px var(--font-mono);
      line-height: 1.5;
      color: var(--faint2);
      transition:
        color var(--duration-fast) var(--ease-out),
        border-color var(--duration-fast) var(--ease-out);
    }
    .toc-desk li.toc-h3 a {
      padding-left: 22px;
    }
    .toc-desk a:hover {
      color: var(--ink);
    }
    .toc-desk a.active {
      color: var(--spot);
      border-left-color: var(--spot);
    }

    .toc-mob {
      display: none;
      margin: 0 0 28px;
    }
    .toc-mob details {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: color-mix(in srgb, var(--color-surface) 50%, transparent);
    }
    .toc-mob summary {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      padding: 10px 14px;
      font: 500 10px var(--font-mono);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--faint);
      user-select: none;
    }
    .toc-mob summary::-webkit-details-marker {
      display: none;
    }
    .toc-mob summary::after {
      content: "+";
      font-size: 13px;
      line-height: 1;
      color: var(--faint2);
      transition: transform 180ms var(--ease-out);
    }
    .toc-mob details[open] summary::after {
      transform: rotate(45deg);
    }
    .toc-mob ol {
      padding: 4px 8px 10px;
      border-top: 1px solid var(--line);
    }
    .toc-mob li {
      margin-bottom: 1px;
    }
    .toc-mob a {
      display: block;
      padding: 6px 10px;
      border-left: 2px solid transparent;
      font: 12px var(--font-mono);
      line-height: 1.5;
      color: var(--faint2);
      transition:
        color var(--duration-fast) var(--ease-out),
        border-color var(--duration-fast) var(--ease-out);
    }
    .toc-mob li.toc-h3 a {
      padding-left: 20px;
    }
    .toc-mob a:hover {
      color: var(--ink);
    }
    .toc-mob a.active {
      color: var(--spot);
      border-left-color: var(--spot);
    }

    /* ---------- prose ---------- */
    .docs-content {
      max-width: 720px;
      min-width: 0;
    }
    .docs-content .crumb {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 0 0 14px;
      font: 500 10px var(--font-mono);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--faint2);
    }
    .docs-content .crumb a {
      color: var(--spot);
      transition: color var(--duration-fast) var(--ease-out);
    }
    .docs-content .crumb a:hover {
      color: var(--spot);
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-thickness: 1px;
    }
    .docs-content .crumb span {
      color: var(--line2);
    }
    .docs-content h1 {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: clamp(30px, 4vw, 40px);
      letter-spacing: -0.01em;
      line-height: 1.08;
      color: var(--ink);
      margin: 0 0 12px;
      text-wrap: balance;
    }
    .docs-content .lead {
      color: var(--faint);
      font-size: 17px;
      line-height: 1.6;
      margin-bottom: 40px;
      text-wrap: pretty;
    }
    .docs-content h2 {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 24px;
      letter-spacing: -0.01em;
      line-height: 1.1;
      color: var(--ink);
      margin: 52px 0 14px;
      text-wrap: balance;
    }
    .docs-content h3 {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 18px;
      letter-spacing: -0.01em;
      line-height: 1.2;
      color: var(--ink);
      margin: 36px 0 10px;
      text-wrap: balance;
    }
    .docs-content h4 {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 16px;
      color: var(--ink);
      margin: 28px 0 8px;
      text-wrap: balance;
    }
    .docs-content h2 a.hd-anchor,
    .docs-content h3 a.hd-anchor,
    .docs-content h4 a.hd-anchor {
      margin-left: 8px;
      font: 400 0.62em var(--font-mono);
      color: var(--faint2);
      text-decoration: none;
      opacity: 0;
      transition: opacity var(--duration-fast) var(--ease-out);
      vertical-align: 2px;
    }
    .docs-content h2:hover a.hd-anchor,
    .docs-content h3:hover a.hd-anchor,
    .docs-content h4:hover a.hd-anchor,
    .docs-content h2 a.hd-anchor:focus-visible,
    .docs-content h3 a.hd-anchor:focus-visible,
    .docs-content h4 a.hd-anchor:focus-visible {
      opacity: 1;
    }
    .docs-content h2 a.hd-anchor:hover,
    .docs-content h3 a.hd-anchor:hover,
    .docs-content h4 a.hd-anchor:hover {
      color: var(--spot);
    }
    .docs-content p {
      margin: 0 0 18px;
      color: var(--dim);
      font-size: 16px;
      line-height: 1.7;
      text-wrap: pretty;
    }
    .docs-content strong {
      color: var(--ink);
      font-weight: 600;
    }
    .docs-content a {
      color: var(--spot);
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-thickness: 1px;
      text-decoration-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
      transition: text-decoration-color var(--duration-fast) var(--ease-out);
    }
    .docs-content a:hover {
      text-decoration-color: var(--spot);
    }
    .docs-content ul,
    .docs-content ol {
      margin: 0 0 18px;
      padding-left: 22px;
      color: var(--dim);
    }
    .docs-content li {
      margin-bottom: 6px;
      line-height: 1.65;
    }
    .docs-content li::marker {
      color: var(--faint2);
    }

    /* ---------- code ---------- */
    .docs-content code {
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--spot);
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1px 5px;
    }
    .docs-content pre {
      background: var(--color-bg);
      border: 1px solid var(--line2);
      border-radius: 6px;
      padding: 16px;
      overflow-x: auto;
      margin: 20px 0;
      position: relative;
    }
    .docs-content pre code {
      background: none;
      border: 0;
      padding: 0;
      color: var(--dim);
      font-size: 13px;
      line-height: 1.7;
    }
    .docs-content pre.hascodehead {
      padding-top: 8px;
    }
    .docs-content .code-head {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px 0 10px;
      margin: -16px -16px 6px;
      border-bottom: 1px solid var(--line);
      padding-left: 16px;
      padding-right: 12px;
    }
    .docs-content .code-head span {
      font: 500 10px var(--font-mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--faint2);
    }
    .docs-content .code-head button {
      margin-left: auto;
      font: 500 10px var(--font-mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--faint2);
      background: transparent;
      border: 1px solid var(--line2);
      border-radius: var(--radius);
      padding: 4px 10px;
      cursor: pointer;
      transition:
        color var(--duration-fast) var(--ease-out),
        border-color var(--duration-fast) var(--ease-out);
    }
    .docs-content .code-head button:hover {
      color: var(--spot);
      border-color: var(--spot);
    }
    .docs-content .code-head button.copied {
      color: var(--run);
      border-color: var(--run);
    }

    /* ---------- tables ---------- */
    .docs-content table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
      font-size: 13.5px;
    }
    .docs-content th,
    .docs-content td {
      border: 1px solid var(--line);
      padding: 7px 12px;
      text-align: left;
      vertical-align: top;
    }
    .docs-content th {
      background: var(--panel);
      color: var(--ink);
      font: 600 11px var(--font-mono);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .docs-content tbody tr:nth-child(even) td {
      background: color-mix(in srgb, var(--color-surface-raised) 45%, transparent);
    }
    .docs-content td code {
      font-size: 12.5px;
      white-space: normal;
      word-break: break-word;
    }

    /* ---------- callouts ---------- */
    .docs-content blockquote {
      border-left: 2px solid var(--spot);
      background: color-mix(in srgb, var(--color-accent) 6%, transparent);
      border-radius: 0 var(--radius) var(--radius) 0;
      padding: 12px 16px;
      margin: 20px 0;
      color: var(--faint);
    }
    .docs-content blockquote p {
      margin: 0;
      color: var(--faint);
    }

    .docs-content hr {
      border: 0;
      border-top: 1px solid var(--line);
      margin: 40px 0;
    }

    /* ---------- prev / next ---------- */
    .docs-next {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      max-width: 720px;
      margin: 64px 0 0 auto;
    }
    .docs-next-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 16px;
      border: 1px solid var(--line);
      border-radius: 6px;
      transition:
        border-color var(--duration-fast) var(--ease-out),
        background var(--duration-fast) var(--ease-out);
    }
    .docs-next-item.right {
      text-align: right;
    }
    .docs-next-item.empty {
      border-color: transparent;
      pointer-events: none;
    }
    .docs-next-item:hover {
      border-color: var(--line2);
      background: var(--panel);
    }
    .docs-next-item span {
      font: 500 10px var(--font-mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--faint2);
    }
    .docs-next-item strong {
      font: 500 13px var(--font-mono);
      color: var(--ink);
    }

    @media (max-width: 1024px) {
      .docs-grid {
        grid-template-columns: 200px minmax(0, 1fr);
        gap: 32px;
      }
    }
    @media (max-width: 768px) {
      .docs-grid {
        grid-template-columns: minmax(0, 1fr);
      }
      .docs-sidebar {
        display: none;
      }
      .toc-mob {
        display: block;
      }
      .toc-mob[hidden] {
        display: none;
      }
      .docs-next {
        grid-template-columns: 1fr;
      }
      .docs-content {
        min-width: 0;
      }
      .docs-content table {
        display: block;
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-collapse: collapse;
      }
      .docs-content table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
      }
    }
  </style>

  <script>
    document.querySelectorAll(".docs-content pre").forEach((pre) => {
      const code = pre.querySelector("code");
      if (!code || !code.textContent) return;
      const lang = (code.className.match(/language-([a-zA-Z0-9]+)/) || [])[1] || "code";
      const head = document.createElement("div");
      head.className = "code-head";
      const label = document.createElement("span");
      label.textContent = lang;
      const btn = document.createElement("button");
      btn.textContent = "Copy";
      btn.setAttribute("aria-label", "Copy code block");
      btn.addEventListener("click", () => {
        const done = () => {
          btn.classList.add("copied");
          btn.textContent = "Copied ✓";
          setTimeout(() => {
            btn.classList.remove("copied");
            btn.textContent = "Copy";
          }, 1800);
        };
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(code.textContent).then(done).catch(() => {});
        } else {
          const ta = document.createElement("textarea");
          ta.value = code.textContent;
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand("copy"); done(); } catch (e) {}
          document.body.removeChild(ta);
        }
      });
      head.append(label, btn);
      pre.parentNode.insertBefore(head, pre);
      pre.classList.add("hascodehead");
    });

    const article = document.querySelector(".docs-content");
    const heads = [...article.querySelectorAll("h2[id], h3[id]")];

    if (heads.length > 1) {
      const makeLi = (h) => {
        const li = document.createElement("li");
        li.className = "toc-" + h.tagName.toLowerCase();
        const a = document.createElement("a");
        a.href = "#" + h.id;
        a.textContent = h.textContent.trim();
        li.appendChild(a);
        return li;
      };

      document.querySelectorAll("ol[data-toc-list]").forEach((ol) => {
        heads.forEach((h) => ol.appendChild(makeLi(h)));
        ol.closest("[data-toc], [data-toc-mobile]").hidden = false;
      });

      const allLinks = [
        ...document.querySelectorAll(".toc-desk ol a"),
        ...document.querySelectorAll(".toc-mob ol a"),
      ];

      const spy = new IntersectionObserver(
        (entries) => {
          const vis = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (!vis) return;
          const id = "#" + vis.target.id;
          allLinks.forEach((l) => l.classList.toggle("active", l.getAttribute("href") === id));
        },
        { rootMargin: "-96px 0px -70% 0px", threshold: 0 },
      );
      heads.forEach((h) => spy.observe(h));
    }

    heads.forEach((h) => {
      const a = document.createElement("a");
      a.className = "hd-anchor";
      a.href = "#" + h.id;
      a.textContent = "#";
      a.setAttribute("aria-label", "Link to this section");
      h.appendChild(a);
    });
  </script>
</Layout>
